{
  "name": "qft-pdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-local PDF editing and organization",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "pages": "node scripts/build-pages.mjs",
    "check": "node scripts/prepare-assets.mjs && node scripts/build-pages.mjs --check && node tests/site-integrity.test.mjs",
    "test": "npm run check && node tests/engine.test.mjs && node tests/preview.test.mjs && node tests/workflows.test.mjs && node tests/release-stamp.test.mjs",
    "test:browser": "node scripts/prepare-assets.mjs && playwright test"
  },
  "license": "MIT",
  "homepage": "https://pdf.qft.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/renphysics/pdf.qft.org.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "1.63.0",
    "pdfjs-dist": "6.4.299"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12"
  }
}
